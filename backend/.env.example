# Runtime environment: development | test | production
NODE_ENV=development

# Application mode: demo | pilot
APP_MODE=pilot

# Port HTTP API backend
PORT=3000

# Origin publik frontend (untuk CORS / proxy / metadata)
APP_ORIGIN=http://127.0.0.1:5173

# Trust proxy (0 lokal, 1 di belakang reverse proxy produksi)
TRUST_PROXY=0

# Sajikan build static frontend/dist dari Express + fallback SPA (opsional di dev, aktif saat NODE_ENV=production jika dist tersedia)
SERVE_FRONTEND_DIST=false

# Koneksi PostgreSQL runtime (hak akses minimal DML)
DATABASE_URL=postgres://tenangin_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:5433/tenangin_production

# Koneksi PostgreSQL admin (hanya untuk migrasi & DDL, opsional di runtime)
DATABASE_ADMIN_URL=postgres://tenangin_admin:CHANGE_ME_ADMIN_PASSWORD@127.0.0.1:5433/tenangin_production

# Worker production: role terpisah dengan DML public dan hak schema pgboss.
WORKER_DATABASE_URL=

# Koneksi database test terpisah
TEST_DATABASE_URL=postgres://tenangin_admin:CHANGE_ME_ADMIN_PASSWORD@127.0.0.1:5433/tenangin_test

# Secret sesi (minimal 32 karakter acak, jangan pernah commit secret asli)
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SESSION_SECRET_MIN_32_CHARS

# Identitas & kunci enkripsi AES-256-GCM (32 byte hex = 64 karakter hex)
ENCRYPTION_KEY_ID=k1
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS_FOR_AES_256_GCM_KEY

# Optional: ring kunci lama untuk rotasi / dekripsi data historis (format: k0:<64hex>,k1:<64hex>)
ENCRYPTION_KEYRING=

# Pengaman agar seed demo tidak pernah berjalan di pilot/produksi
ALLOW_DEMO_SEED=false

# Push Notification Eksternal (VAPID, opsional — gunakan pasangan kunci tetap saat fitur diaktifkan)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:pengelola@tenangin.id

# Tuning kapasitas pool PostgreSQL & batas timeout kueri (ms)
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# Tingkat log tersanitasi: debug | info | warn | error | silent
LOG_LEVEL=info
