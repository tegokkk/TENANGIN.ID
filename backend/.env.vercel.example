# Masukkan di Vercel > Project > Settings > Environment Variables.
# Root Directory proyek harus root repository, bukan frontend/ atau backend/.
NODE_ENV=production
APP_MODE=pilot
ALLOW_DEMO_SEED=false
APP_ORIGIN=https://NAMA-PROYEK.vercel.app
TRUST_PROXY=1
DATABASE_URL=postgresql://tenangin_app:ISI_PASSWORD@HOST_POSTGRES:5432/tenangin_production?sslmode=require
SESSION_SECRET=ISI_SECRET_ACAK_MINIMAL_32_KARAKTER
ENCRYPTION_KEY_ID=k1
ENCRYPTION_KEY=ISI_KUNCI_HEX_64_KARAKTER
ENCRYPTION_KEYRING=
DB_POOL_MIN=0
DB_POOL_MAX=3
DB_STATEMENT_TIMEOUT_MS=15000
LOG_LEVEL=info
# Gunakan pasangan kunci tetap yang sama dengan worker untuk notifikasi browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:pengelola@domain-sekolah.example
# DATABASE_ADMIN_URL, WORKER_DATABASE_URL, TEST_* dan BOOTSTRAP_* tidak dimasukkan ke API Vercel.
