# Salin ke backend/.env.production di server; isi nilai resmi dan secret unik.
NODE_ENV=production
APP_MODE=pilot
ALLOW_DEMO_SEED=false
PORT=3000
APP_ORIGIN=https://domain-sekolah.example
# API mengikat loopback; reverse proxy HTTPS berada pada server yang sama.
TRUST_PROXY=1
SERVE_FRONTEND_DIST=true
DATABASE_URL=postgres://tenangin_app:REPLACE_WITH_RUNTIME_PASSWORD@database.internal:5432/tenangin_production
# Hanya diberikan pada proses migrasi operator, bukan service API/worker.
DATABASE_ADMIN_URL=
# Worker memakai role terpisah dengan DML public dan kepemilikan schema pgboss.
WORKER_DATABASE_URL=postgres://tenangin_worker:REPLACE_WITH_WORKER_PASSWORD@database.internal:5432/tenangin_production
SESSION_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ENCRYPTION_KEY_ID=k1
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
ENCRYPTION_KEYRING=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:pengelola@domain-sekolah.example
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
LOG_LEVEL=info
